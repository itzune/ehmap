# Secrets (R2 upload token): never commit — see .env.example
.env

# Python
.venv/
__pycache__/
*.pyc

# Downloaded source data (reproduce with scripts/00_download.py)
data/raw/

# Scratch output (published maps go to dist/)
out/

# Tile archives over the 100 MB push limit: in the Cloudflare R2 bucket behind
# tiles.itzune.eus, uploaded by scripts/upload_tiles.sh
site/data/topo.pmtiles
site/data/contours.pmtiles

# Large / binary outputs are published as GitHub Release assets (scripts/release.sh)
ehmap.rgis
dist/**/*.tif
dist/sea/sea_level_annual.csv
site/data/*.part
