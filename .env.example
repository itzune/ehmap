# Copy to .env (gitignored) and fill in. Used by scripts/upload_tiles.sh to push the
# large tile archives to the Cloudflare R2 bucket behind tiles.itzune.eus.
# Create the token in the Cloudflare dashboard: R2 → Manage API tokens → Account API
# token, "Object Read & Write", limited to the one bucket.
R2_BUCKET=ehmap-tiles
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
